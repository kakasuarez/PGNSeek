# ── MongoDB / Redis ───────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pgnseek
REDIS_URL=redis://localhost:6379/0

# ── Supabase Storage ──────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<your-anon-or-service-role-key>
SUPABASE_BUCKET=pgn-uploads

# ── Ingestion pipeline ─────────────────────────────────────────
# where your 7z-extracted PGN files live
PGN_DATA_DIR=./data/pgn
INGESTION_STATE_FILE=./data/json/ingestion_state.json
ECO_TO_OPENING_FILE=./data/json/eco_to_opening.json
# skip games before this year
MIN_YEAR=2010

# ── Feature extraction thresholds ─────────────────────────────
# avg_material_swings above this = attacking game
AGGRESSION_THRESHOLD=3.0
# material swing >= this in one move = sacrifice
SACRIFICE_DELTA=3
# total pieces on board to classify as endgame
ENDGAME_MAX_PIECES=12

# ── API ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
RATE_LIMIT_PER_MINUTE=60
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── Caching ────────────────────────────────────────────────────
# 5 min TTL on repeated identical queries
CACHE_TTL_SECONDS=300
# max cached query results in memory
CACHE_MAX_SIZE=1000

# ── Engine / Opening Review ───────────────────────────────────
# path to local stockfish binary for opening review scripts
STOCKFISH_PATH=
# search depth for local engine fallback / initial analysis
OPENING_REVIEW_ENGINE_DEPTH=12
OPENING_REVIEW_MAX_PLIES=20

# ── Logging ────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json (prod) | pretty (dev)
LOG_FORMAT=json
# development | production
ENV=development
